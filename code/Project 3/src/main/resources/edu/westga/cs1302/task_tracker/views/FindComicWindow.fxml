<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.westga.cs1302.task_tracker.views.FindComicWindow">

    <Label text="Find Comic"/>

    <HBox spacing="5">
        <Label text="Title:"/>
        <TextField fx:id="titleTextField"/>
    </HBox>

    <HBox spacing="5">
        <Label text="Issue Number:"/>
        <TextField fx:id="issueNumberTextField"/>
    </HBox>

    <HBox spacing="10">
        <Button fx:id="searchButton" text="Search" onAction="#search"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#cancel"/>
    </HBox>
</VBox>