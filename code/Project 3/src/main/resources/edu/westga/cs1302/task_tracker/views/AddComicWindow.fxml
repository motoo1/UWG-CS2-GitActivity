<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="200.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.task_tracker.views.AddComicWindow">
    <children>
        <Label layoutX="14.0" layoutY="14.0" text="Comic Title:"/>
        <TextField fx:id="titleTextField" layoutX="100.0" layoutY="10.0" prefWidth="200.0"/>
        
        <Label layoutX="14.0" layoutY="50.0" text="Issue Number:"/>
        <TextField fx:id="issueNumberTextField" layoutX="100.0" layoutY="46.0" prefWidth="200.0"/>
        
        <Button fx:id="confirmButton" layoutX="60.0" layoutY="100.0" text="Confirm" onAction="#confirm"/>
        <Button fx:id="cancelButton" layoutX="180.0" layoutY="100.0" text="Cancel" onAction="#cancel"/>
    </children>
</AnchorPane>